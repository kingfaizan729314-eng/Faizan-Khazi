.product-detail-page { padding: 2rem 0 4rem; }
.back-link { display: inline-flex; align-items: center; gap: 0.4rem; color: #64748b; text-decoration: none; font-size: 0.875rem; margin-bottom: 1.5rem; }
.back-link:hover { color: #3b82f6; }

.product-detail { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; margin-bottom: 3rem; }

/* Images */
.main-image { position: relative; background: #f8fafc; border-radius: 14px; overflow: hidden; aspect-ratio: 4/3; }
.main-image img { width: 100%; height: 100%; object-fit: cover; }
.img-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(0,0,0,0.5); border: none; color: #fff; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; }
.img-nav.prev { left: 10px; }
.img-nav.next { right: 10px; }
.thumb-strip { display: flex; gap: 0.75rem; margin-top: 0.875rem; flex-wrap: wrap; }
.thumb { background: #f8fafc; border: 2px solid #e2e8f0; border-radius: 8px; overflow: hidden; width: 64px; height: 64px; cursor: pointer; padding: 0; transition: border-color 0.15s; }
.thumb.active { border-color: #3b82f6; }
.thumb img { width: 100%; height: 100%; object-fit: cover; }

/* Info */
.product-brand-label { font-size: 0.75rem; font-weight: 700; color: #3b82f6; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.5rem; }
.product-info-panel h1 { font-size: 1.625rem; font-weight: 800; color: #0f172a; margin-bottom: 0.875rem; line-height: 1.3; }

.product-meta { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
.stars { display: flex; align-items: center; gap: 0.2rem; }
.stars span { font-size: 0.875rem; color: #374151; font-weight: 600; margin-left: 0.3rem; }
.review-count { color: #9ca3af; font-weight: 400 !important; }
.stock-badge { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.8rem; font-weight: 600; padding: 0.25rem 0.65rem; border-radius: 100px; }
.stock-badge.in-stock { background: #dcfce7; color: #16a34a; }
.stock-badge.oos { background: #fee2e2; color: #dc2626; }

.price-block { display: flex; align-items: baseline; gap: 0.875rem; margin-bottom: 1rem; }
.big-price { font-size: 2rem; font-weight: 800; color: #0f172a; }
.orig-price { font-size: 1.1rem; color: #9ca3af; text-decoration: line-through; }
.discount-badge { background: #fef2f2; color: #ef4444; font-size: 0.8rem; font-weight: 700; padding: 0.2rem 0.5rem; border-radius: 5px; }

.short-desc { color: #64748b; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.5rem; }

.add-to-cart-row { display: flex; gap: 1rem; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap; }
.qty-control { display: flex; align-items: center; gap: 0; border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; }
.qty-control button { background: #f8fafc; border: none; width: 36px; height: 40px; font-size: 1.1rem; cursor: pointer; color: #374151; }
.qty-control button:hover { background: #e2e8f0; }
.qty-control span { width: 44px; text-align: center; font-weight: 600; font-size: 0.95rem; }

.btn-add-big { display: flex; align-items: center; gap: 0.5rem; background: #3b82f6; color: #fff; border: none; padding: 0.65rem 1.5rem; border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer; transition: background 0.15s; flex: 1; justify-content: center; }
.btn-add-big:hover { background: #2563eb; }
.btn-add-big:disabled { background: #cbd5e1; cursor: not-allowed; }

/* Specs */
.specs-table { margin-top: 0.5rem; }
.specs-table h3 { font-size: 1rem; font-weight: 700; color: #0f172a; margin-bottom: 0.75rem; }
.specs-table table { width: 100%; border-collapse: collapse; }
.specs-table td { padding: 0.5rem 0.75rem; font-size: 0.875rem; border-bottom: 1px solid #f1f5f9; }
.spec-key { color: #64748b; font-weight: 600; width: 40%; }
.spec-val { color: #374151; }

/* Description */
.product-desc-section { padding: 2rem; background: #f8fafc; border-radius: 12px; margin-bottom: 2.5rem; }
.product-desc-section h2 { font-size: 1.2rem; font-weight: 700; color: #0f172a; margin-bottom: 0.875rem; }
.product-desc-section p { color: #374151; line-height: 1.75; font-size: 0.95rem; }

/* Reviews */
.reviews-section { margin-bottom: 3rem; }
.reviews-section h2 { font-size: 1.25rem; font-weight: 700; color: #0f172a; margin-bottom: 1.5rem; }

.review-form { background: #f8fafc; border-radius: 12px; padding: 1.5rem; margin-bottom: 2rem; }
.review-form h3 { font-size: 1rem; font-weight: 700; color: #0f172a; margin-bottom: 1rem; }
.star-select { display: flex; gap: 0.25rem; margin-bottom: 1rem; }
.star-select button { background: transparent; border: none; cursor: pointer; padding: 0.1rem; }
.review-input, .review-textarea { width: 100%; padding: 0.6rem 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; font-size: 0.875rem; outline: none; margin-bottom: 0.75rem; font-family: inherit; }
.review-input:focus, .review-textarea:focus { border-color: #3b82f6; }
.review-textarea { resize: vertical; }

.reviews-list { display: flex; flex-direction: column; gap: 1rem; }
.review-card { padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; }
.review-header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem; flex-wrap: wrap; }
.reviewer-name { font-weight: 600; color: #0f172a; font-size: 0.9rem; }
.review-stars { display: flex; gap: 0.1rem; }
.review-date { color: #9ca3af; font-size: 0.8rem; margin-left: auto; }
.review-title { font-weight: 600; color: #374151; font-size: 0.875rem; margin-bottom: 0.25rem; }
.review-body { color: #64748b; font-size: 0.875rem; line-height: 1.6; margin: 0; }

/* Related */
.related-section h2 { font-size: 1.25rem; font-weight: 700; color: #0f172a; margin-bottom: 1.5rem; }

.product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 1.25rem; }

@media (max-width: 768px) {
  .product-detail { grid-template-columns: 1fr; gap: 2rem; }
  .big-price { font-size: 1.5rem; }
}

.cart-page { padding: 2rem 0 4rem; }
.cart-page h1 { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 1.75rem; }
.cart-page h1 span { color: #64748b; font-weight: 400; font-size: 1.1rem; }

.cart-empty { text-align: center; padding: 6rem 2rem; }
.cart-empty .empty-icon { color: #cbd5e1; margin-bottom: 1rem; display: flex; justify-content: center; }
.cart-empty h2 { font-size: 1.5rem; font-weight: 700; color: #0f172a; margin-bottom: 0.5rem; }
.cart-empty p { color: #64748b; margin-bottom: 1.75rem; }

.cart-layout { display: grid; grid-template-columns: 1fr 320px; gap: 2rem; align-items: start; }

/* Items */
.cart-items { display: flex; flex-direction: column; gap: 0; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }

.cart-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.25rem;
  border-bottom: 1px solid #f1f5f9;
}
.cart-item:last-child { border-bottom: none; }

.cart-item img { width: 80px; height: 80px; object-fit: cover; border-radius: 8px; background: #f8fafc; flex-shrink: 0; }

.item-details { flex: 1; min-width: 0; }
.item-name { display: block; font-weight: 600; color: #0f172a; text-decoration: none; font-size: 0.9rem; margin-bottom: 0.2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.item-name:hover { color: #3b82f6; }
.item-variant { font-size: 0.78rem; color: #64748b; }
.item-price { font-size: 0.8rem; color: #94a3b8; margin-top: 0.25rem; }

.item-qty { display: flex; align-items: center; gap: 0; border: 1px solid #e2e8f0; border-radius: 7px; overflow: hidden; }
.item-qty button { background: #f8fafc; border: none; padding: 0.35rem 0.6rem; cursor: pointer; color: #374151; display: flex; align-items: center; }
.item-qty button:hover:not(:disabled) { background: #e2e8f0; }
.item-qty button:disabled { opacity: 0.4; cursor: not-allowed; }
.item-qty span { padding: 0 0.65rem; font-weight: 600; font-size: 0.9rem; min-width: 32px; text-align: center; }

.item-subtotal { font-weight: 700; color: #0f172a; font-size: 0.95rem; min-width: 64px; text-align: right; }

.remove-btn { background: transparent; border: none; color: #9ca3af; cursor: pointer; padding: 0.35rem; border-radius: 6px; display: flex; align-items: center; }
.remove-btn:hover { color: #ef4444; background: #fef2f2; }

/* Summary */
.cart-summary { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 1.5rem; position: sticky; top: 80px; }
.cart-summary h3 { font-size: 1.1rem; font-weight: 700; color: #0f172a; margin-bottom: 1.25rem; }

.summary-row { display: flex; justify-content: space-between; font-size: 0.9rem; color: #374151; margin-bottom: 0.75rem; }
.free { color: #16a34a; font-weight: 600; }
.summary-total { display: flex; justify-content: space-between; font-size: 1.1rem; font-weight: 800; color: #0f172a; margin: 1.25rem 0; padding-top: 1rem; border-top: 2px solid #e2e8f0; }

.free-shipping-hint { background: #eff6ff; color: #1d4ed8; border-radius: 7px; padding: 0.65rem 0.875rem; font-size: 0.8rem; margin-bottom: 1rem; }

.btn-checkout { display: flex; align-items: center; justify-content: center; gap: 0.4rem; background: #3b82f6; color: #fff; text-decoration: none; padding: 0.75rem; border-radius: 8px; font-weight: 600; font-size: 0.95rem; transition: background 0.15s; width: 100%; margin-bottom: 0.75rem; }
.btn-checkout:hover { background: #2563eb; }

.continue-shopping { display: block; text-align: center; color: #64748b; text-decoration: none; font-size: 0.875rem; }
.continue-shopping:hover { color: #3b82f6; }

.btn-primary { display: inline-flex; align-items: center; gap: 0.4rem; background: #3b82f6; color: #fff; text-decoration: none; padding: 0.7rem 1.5rem; border-radius: 8px; font-weight: 600; font-size: 0.95rem; }
.btn-primary:hover { background: #2563eb; }

@media (max-width: 768px) {
  .cart-layout { grid-template-columns: 1fr; }
  .cart-summary { position: static; }
}
